{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "",
  "buildCommand": "node scripts/build-site.mjs",
  "outputDirectory": "dist",
  "cleanUrls": false,
  "trailingSlash": false,
  "redirects": [
    {"source": "/:locale(en|pl|de)", "destination": "/", "permanent": true},
    {"source": "/:locale(en|pl|de)/contact", "destination": "/kontakt.html", "permanent": true},
    {"source": "/contact", "destination": "/kontakt.html", "permanent": true},
    {"source": "/kontakt", "destination": "/kontakt.html", "permanent": true},
    {"source": "/:locale(en|pl|de)/projects", "destination": "/projekty.html", "permanent": true},
    {"source": "/projects", "destination": "/projekty.html", "permanent": true},
    {"source": "/projekty", "destination": "/projekty.html", "permanent": true},
    {"source": "/:locale(en|pl|de)/faq", "destination": "/#pytania", "permanent": true},
    {"source": "/faq", "destination": "/#pytania", "permanent": true},
    {"source": "/:locale(en|pl|de)/:page(products|process|about|configurator)", "destination": "/#system", "permanent": true},
    {"source": "/:page(products|process|about|configurator)", "destination": "/#system", "permanent": true}
  ],
  "headers": [
    {"source": "/(.*)", "headers": [
      {"key": "X-Content-Type-Options", "value": "nosniff"},
      {"key": "Referrer-Policy", "value": "strict-origin-when-cross-origin"}
    ]}
  ]
}
